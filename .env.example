# cp .env.example .env 후 값을 채운다. .env는 커밋 금지.
# 로컬 개발용 기본값 예시는 README 참조.

# --- 공통 ---
APP_ENV=
HOST_BIND_IP=
# 선택: 로그 형식(json|text)과 레벨. 비우면 json / INFO. 로컬은 LOG_FORMAT=text 권장
LOG_FORMAT=
LOG_LEVEL=

# --- 호스트 포트 ---
WEB_PORT=
APP_PORT=
LOCALSTACK_PORT=
COGNITO_PORT=

# --- DB ---
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- AWS / LocalStack ---
LOCALSTACK_AUTH_TOKEN=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
KMS_KEY_ALIAS=
APP_SECRET_NAME=

# --- Cognito (로컬: cognito-local) ---
COGNITO_ISSUER_DOMAIN=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# D7: 운영자 보호 API 에 TOTP 등록 + 최근 로그인 요구. cognito-local 은 TOTP 가 불완전하므로 로컬은 false 권장.
OPERATOR_MFA_REQUIRED=false

# --- LLM (A2, Bedrock) ---
# none 이면 AI 단계를 건너뛰고 규칙 결과만 나온다. 실제 호출은 bedrock + 본인 IAM 키.
# 위 AWS_* 는 LocalStack 더미 키라 Bedrock 에 쓸 수 없어 따로 받는다.
LLM_PROVIDER=none
LLM_MODEL_ID=global.amazon.nova-2-lite-v1:0
BEDROCK_ACCESS_KEY_ID=
BEDROCK_SECRET_ACCESS_KEY=

# --- 임베딩 (D20). 로컬은 `docker compose --profile embed up -d embedder` 후 EMBEDDING_URL=http://embedder:8080
# EMBEDDER_IMAGE 는 PC 아키텍처에 맞춘다: arm64 는 ...:cpu-arm64-1.9, x86 은 ...:cpu-1.9
EMBEDDING_MODEL=bge-m3
EMBEDDING_URL=
EMBEDDER_IMAGE=

# --- 공공 API (C4·C14). 키는 커밋 금지. AWS 는 Secrets Manager nesume/<env>/app 의 같은 이름 필드
WORK24_API_BASE_URL=https://www.work24.go.kr
WORK24_JOB_API_KEY=
WORK24_TRAINING_API_KEY=
WORK24_OCCUPATION_API_KEY=
WORK24_DUTY_API_KEY=
WORK24_COMMON_CODE_API_KEY=
SEOUL_OPENAPI_BASE_URL=http://openapi.seoul.go.kr:8088
SEOUL_OPENAPI_KEY=
KMOOC_API_KEY=
