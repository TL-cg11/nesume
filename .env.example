# cp .env.example .env 후 값을 채운다. .env는 커밋 금지.
# 로컬 개발용 기본값 예시는 README 참조.

# --- 공통 ---
APP_ENV=
HOST_BIND_IP=

# --- 호스트 포트 ---
WEB_PORT=
APP_PORT=
LOCALSTACK_PORT=
COGNITO_PORT=

# --- DB ---
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- AWS / LocalStack ---
LOCALSTACK_AUTH_TOKEN=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
KMS_KEY_ALIAS=
APP_SECRET_NAME=

# --- Cognito (로컬: cognito-local) ---
COGNITO_ISSUER_DOMAIN=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
