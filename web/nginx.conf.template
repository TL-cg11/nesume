# nginx 공식 이미지가 기동 시 envsubst로 ${APP_UPSTREAM}, ${COGNITO_CONNECT_SRC}를 치환한다.
# COGNITO_CONNECT_SRC: 브라우저가 직접 호출하는 Cognito 주소(CSP connect-src).
#   로컬 http://localhost:9229 / 운영 https://cognito-idp.ap-northeast-2.amazonaws.com
server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # D7: QR(TOTP)은 data: 이미지, 스타일은 React 인라인 style 속성 때문에 'unsafe-inline' 허용.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; connect-src 'self' ${COGNITO_CONNECT_SRC}; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    # /api/* -> app의 /* (접두사 제거)
    location /api/ {
        proxy_pass http://${APP_UPSTREAM}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # D7: 런타임 설정. 기동 스크립트(30-config-json.sh)가 /tmp/config.json 에 쓴다.
    location = /config.json {
        alias /tmp/config.json;
        default_type application/json;
        add_header Cache-Control "no-store" always;
    }

    # SPA 라우팅
    location / {
        try_files $uri $uri/ /index.html;
    }
}
